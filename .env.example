# SmartStudy Agent Environment Variables Template
# Copy this file to .env and fill in your API key

# ------------------------------------------------------------------
# Option A: Groq API (Recommended - Extremely Fast & Free Tier)
# Get key from: https://console.groq.com/keys
# ------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
ENDPOINT_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------
# Option B: Grok (xAI API)
# Get key from: https://console.x.ai/
# ------------------------------------------------------------------
# GROK_API_KEY=xai-your_grok_api_key_here
# MODEL_NAME=grok-2-latest
# ENDPOINT_URL=https://api.x.ai/v1

# ------------------------------------------------------------------
# Option C: GitHub Models API / OpenAI
# ------------------------------------------------------------------
# GITHUB_TOKEN=your_github_token_here
# MODEL_NAME=gpt-4o-mini
# ENDPOINT_URL=https://models.inference.ai.azure.com

# ------------------------------------------------------------------
# General Settings
# ------------------------------------------------------------------
# Reference Today Date (Optional, defaults to system current date)
TODAY_DATE=2026-08-25
